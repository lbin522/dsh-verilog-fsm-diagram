{
  "name": "@local/verilog-fsm-diagram",
  "version": "1.9.0",
  "private": true,
  "description": "Convert Verilog FSMs into interactive state diagrams, switch transition labels between text and per-edge numbers, and generate synthesizable Verilog from editable transition tables.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "cli.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "bin": {
    "verilog-fsm": "./cli.mjs"
  }
}
